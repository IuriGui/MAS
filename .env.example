GOOGLE_API_KEY=coloque-sua-chave-aqui

# Rastreamento no LangSmith (opcional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=sis

# MODEL=google_genai:gemini-3.8-flash
# MAX_TENTATIVAS=2
# VALIDAR=1
# SAIDA_DIR=saida
# CONTEXTO=exemplos/erp/contexto.json
# IMPL_LOTE=5
# IMPL_LIMITE_CONTEXTO=400000  # caracteres de dependências inteiras por lote
# Limites contra repetição sem fim (ver mas/config.py)
# LIMITE_PASSOS_AGENTE=3   # chamadas ao modelo por tentativa
# MAX_RETRIES_API=3        # repetições em erro HTTP
# TIMEOUT_API=600          # segundos por chamada
# Sandbox Docker dos Implementadores (ver mas/config.py)
# SANDBOX=1                  # 0 = Implementadores só com saída estruturada
# SANDBOX_IMAGEM=dockersandbox
# SANDBOX_PORTAS=5173        # ex.: 5173,8080 para abrir front e API no host
# LIMITE_PASSOS_SANDBOX=250  # passos do grafo por tentativa no sandbox
