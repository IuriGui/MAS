  "relationships": [
    {
      "source": "users",
      "target": "user_roles",
      "cardinality": "1:N",
      "via": "user_roles.user_id",
      "description": "A user has one or more tenant role assignment records."
    },
    {
      "source": "roles",
      "target": "user_roles",
