  "screens": [],
  "conventions": [
    "All module entities MUST extend BaseEntity or BaseAuditableEntity from com.distributor.erp.common.persistence.",
    "All entity primary keys and foreign keys MUST be java.util.UUID generated using UuidV7Generator.",
    "All tenant-scoped queries MUST obtain the active tenant through TenantContext.getTenantId() or rely on the Hibernate tenant filter.",
    "All business exceptions MUST extend BusinessException or use standard subclasses (ResourceNotFoundException, ConflictException, ForbiddenException, UnauthorizedException) and never throw raw RuntimeExceptions directly to clients.",
    "All controllers MUST expose endpoints under /api/v1/... and return RFC 7807 ProblemDetails on errors via GlobalExceptionHandler.",
    "All inter-module state change notifications MUST be published via OutboxPublisher.publish(eventType, aggregateId, payload) inside the business transaction.",
    "All paginated GET endpoints MUST accept PageRequestDto and return PageResponseDto<T>.",
    "All frontend module route files MUST export an array of RouteObject as default export or named export usersRoutes.",
    "All frontend API calls MUST use the shared apiClient from src/api/client.ts which attaches the Bearer token and tenant context."
  ],
  "implementation_notes": [
    "The shared database uses a tenant_id discriminator column on all business tables. In the BASE plan, BaseEntity provides the tenant_id field and soft-delete deleted_at column.",
    "Inter-module communication is asynchronous and reliable using a PostgreSQL Transactional Outbox table initialized via V0__init_outbox.sql and serviced by OutboxPublisher and OutboxProcessorService.",
    "RFC 7807 Problem Details error formatting is handled universally by GlobalExceptionHandler in com.distributor.erp.common.error.",
    "The frontend AppRouter explicitly imports usersRoutes from src/modules/users/routes.tsx which will be defined in the Users module."
  ]
}